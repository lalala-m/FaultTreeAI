# ============================================================
# 故障检修系统 环境变量模板
# 说明：把本文件复制为 .env 后，填入你自己的 Key 即可运行
# ============================================================

# ── LLM 大模型（必需）────────────────────────────────────────
# 方案 A：豆包方舟 OpenAI 兼容接口（推荐）
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=openai
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_KEY=你的_豆包方舟_API_Key
LLM_MODEL=doubao-1.5-pro-32k

# 方案 B：百度千帆 OpenAI 兼容接口
# LLM_PROVIDER=openai
# LLM_FALLBACK_PROVIDER=openai
# OPENAI_BASE_URL=https://qianfan.baidubce.com/v2
# OPENAI_API_KEY=你的千帆_API_Key
# LLM_MODEL=glm-5.1

# ── Embedding 向量模型（必需：用于知识库 RAG）───────────────
# 方案 A：千帆 OpenAI 兼容接口（推荐，无需额外申请百度 Key）
EMBED_PROVIDER=openai
EMBED_MODEL=bge-large-zh
EMBED_DIM=1024

# 方案 B：百度独立 Embedding 接口（如千帆不可用，请取消下方注释并填写）
# EMBED_PROVIDER=baidu
# BAIDU_EMBED_API_KEY=你的百度_Embedding_API_Key
# BAIDU_EMBED_SECRET_KEY=你的百度_Embedding_Secret_Key
# BAIDU_EMBED_MODEL=bge-large-zh

# ── 数据库（Docker pgvector 默认配置，一般不用改）────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=faulttree123
DB_NAME=postgres
DATABASE_URL=postgresql+asyncpg://postgres:faulttree123@localhost:5432/postgres

# ── 百度语音识别 VOP（备用：用于视频/音频 ASR）───────────────
# 获取地址：https://ai.baidu.com/tech/speech/asr
BAIDU_VOP_API_KEY=
BAIDU_VOP_SECRET_KEY=
BAIDU_VOP_DEV_PID=1537

# ── 火山引擎 / 豆包语音（推荐：用于 RTC ASR/TTS）──────────────
# 控制台：https://console.volcengine.com/speech/service/8
# 获取 APP_ID / Access Key 或统一 API Key 后填入下方
RTC_ASR_PROVIDER=volcengine
RTC_TTS_PROVIDER=volcengine

# 新版控制台单 Key（优先使用）
VOLCENGINE_API_KEY=你的_火山_语音_API_Key

# 旧版控制台应用鉴权（当单 Key 为空时使用）
VOLCENGINE_APP_ID=你的_火山_语音_APP_ID
VOLCENGINE_ACCESS_KEY=你的_火山_语音_Access_Key
# VOLCENGINE_ACCESS_TOKEN=你的_火山_语音_Access_Token

# ASR 资源 ID（默认大模型录音文件识别极速版，同步返回）
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# TTS 音色与输出采样率
# VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
# 已由后端根据音色自动推断（推荐留空）：S_*->seed-icl-2.0, *_uranus_*|saturn_*->seed-tts-2.0, 其他(moon_bigtts等)->seed-tts-1.0
VOLCENGINE_TTS_SPEAKER=zh_female_wanqudashu_moon_bigtts
VOLCENGINE_TTS_EMOTION=
VOLCENGINE_TTS_SPEED_RATIO=1.0
VOLCENGINE_TTS_SAMPLE_RATE=24000

# ── RTC 实时通话（可选：不用 RTC Bot 可留空）──────────────────
RTC_APP_ID=
RTC_APP_KEY=
RTC_DEFAULT_ROOM=
RTC_ROOM_PREFIX=faulttree
RTC_TOKEN_EXPIRE_SECONDS=86400
RTC_AI_USER_PREFIX=ai-bot
RTC_AI_DISPLAY_NAME=故障树AI
RTC_AI_WELCOME_MESSAGE=我已接通。你可以直接语音提问，也可以让我持续观察摄像头画面并做故障判断。

# RTC AI Bot Linux SDK（可选）
RTC_BOT_ENABLED=false
RTC_BOT_SO_PATH=deploy/vm/rtc_bot/build/librtc_bot.so

# ── 原生多模态 VLM（可选：不用视觉大模型可留空）──────────────
# 豆包方舟视觉模型（OpenAI 兼容）
VLM_PROVIDER=openai
VLM_MODEL=doubao-1.5-vision-pro-32k
VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VLM_API_KEY=你的_豆包方舟_API_Key

# 其他 OpenAI 兼容 VLM
# VLM_PROVIDER=openai
# VLM_MODEL=gpt-4o
# VLM_BASE_URL=https://api.openai.com/v1
# VLM_API_KEY=sk-xxx

# ── 实时通话分析配置（可选，一般保持默认）────────────────────
REALTIME_FRAME_MODEL_KEY=auto
REALTIME_FRAME_CONF=0.15
REALTIME_FRAME_DEVICE=cpu
REALTIME_FRAME_INTERVAL_MS=2000
REALTIME_MIN_ANOMALY_FRAMES=2
REALTIME_ALERT_COOLDOWN_SECONDS=10.0
REALTIME_ENABLE_LLM_ON_NORMAL=false

# ── 飞书/Lark 故障检索机器人（可选）───────────────────────────
# 1. 先在飞书开放平台创建/选择一个自建应用，开启「机器人」能力
# 2. 在「事件订阅」中添加：
#      im.message.receive_v1
#      im.chat.access_event.bot_p2p_chat_entered_v1
#    如果使用「会议诊断」，还需要开启：
#      vc.recording.recording_transcript_generated_v1
#    并授予应用 vc:reserve 和 vc:recording:read 权限
#
# 运行模式选择：
# A. 原生 WebSocket 客户端模式（VM/内网推荐，无需公网域名，无需 lark-cli）
#    start_all.sh 默认使用 lark-oapi.ws.Client 接收事件。
#    飞书后台「事件订阅」方式选择「使用 Platform API 订阅事件」即可。
#
# B. HTTP 回调模式（需要公网 HTTPS 域名）
#    飞书后台「事件订阅」请求地址填：https://你的域名/api/feishu/webhook
#
# C. lark-cli 事件消费模式（旧方案，需要安装并登录 lark-cli）
#    FEISHU_USE_WS_CLIENT=false ./scripts/start_feishu_bot.sh
FEISHU_ENABLED=false
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_BOT_NAME=故障检索机器人
FEISHU_WEBHOOK_PATH=/api/feishu/webhook
FEISHU_REPLY_MAX_LENGTH=3000
# 使用 lark-oapi 原生 WebSocket 客户端（支持交互卡片按钮）
FEISHU_USE_WS_CLIENT=true
# 视频排查页面域名，例如 https://your-domain.com 或 http://虚拟机IP:8000
# 留空则使用相对路径 /static/rtc-call.html
FEISHU_RTC_BASE_URL=
# 飞书机器人打开的网页端地址，例如 https://192.168.1.226:8443
# 留空则不启用「网页诊断」链接
FEISHU_WEB_APP_URL=
